{
  "contract": "phase51-completion-chain",
  "spawn": {
    "tool": "sessions_spawn",
    "kind": "standard",
    "completionTarget": "parent"
  },
  "parent": {
    "yieldAfterSpawn": true,
    "yieldTool": "sessions_yield",
    "ownerNudges": 0,
    "advanceAfterDoneExceptBoundReview": true
  },
  "tasks": [
    {
      "id": "T1",
      "role": "implement",
      "dependsOn": []
    },
    {
      "id": "T2",
      "role": "verify-test",
      "dependsOn": [
        "T1"
      ]
    },
    {
      "id": "T3",
      "role": "independent-review",
      "dependsOn": [
        "T2"
      ],
      "ledgerRole": "review",
      "reviewTarget": "T2"
    }
  ],
  "advance": {
    "requiredState": "done, except exact bound review may consume review-ready target",
    "boundReviewException": "review-ready target with exact task, attempt, and artifact digest"
  },
  "failure": {
    "status": "blocked"
  },
  "final": {
    "stopAt": "human-pr-review",
    "autoMerge": false
  }
}
