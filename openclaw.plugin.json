{
  "id": "openclaw-orchestration-adapter",
  "name": "Orchestration Adapter",
  "description": "Least-privilege worker dispatch: per-run tool grants enforced by before_tool_call.",
  "skills": [
    "skills/requesting-code-review",
    "skills/channel-context-bridge",
    "skills/expansion-grant-guard",
    "skills/task-handoff",
    "skills/loop-circuit-breaker",
    "skills/writing-plans",
    "skills/workflow-orchestration",
    "skills/dispatching-parallel-agents",
    "skills/executing-plans",
    "skills/quality-gate-orchestrator",
    "skills/spend-circuit-breaker",
    "skills/long-running-task-management",
    "skills/verification-before-completion",
    "skills/multi-agent-coordinator",
    "skills/subagent-driven-development",
    "skills/orchestration-2.0"
  ],
  "activation": {
    "onStartup": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "lifecycleDiagnostics": {
        "type": "boolean",
        "default": false,
        "description": "Emit sanitized worker binding lifecycle events for troubleshooting. Off by default; never logs task contents or raw identifiers."
      },
      "canary": {
        "type": "boolean",
        "default": false,
        "description": "Register the opt-in orchestration_canary tool (constant, no side effects) so a worker tool grant can be proven. Still requires dispatch.allowedTools and the operator tool allowlist."
      },
      "agentId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "workerRoutes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Deployment-owned worker candidate pools and automatic-use allow-list. Candidate order sets preference; a failed execution does not trigger model failover.",
        "properties": {
          "priority": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cheap": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "standard": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strong": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review": {
            "type": "array",
            "description": "Dedicated review intent: deployment-owned ordered candidates for review tasks.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "dispatch": {
        "type": "object",
        "additionalProperties": false,
        "description": "Enables the optional orchestration_dispatch agent tool. Operator-owned ceiling: the calling agent may only narrow it.",
        "properties": {
          "allowedTools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowedCalls": {
            "type": "array",
            "description": "Optional deployment-owned exact tool-argument allowlist. When present, every allowed tool must have at least one exact call entry; worker calls with different or extra arguments are blocked.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["toolName", "params"],
              "properties": {
                "toolName": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "type": "object"
                }
              }
            }
          },
          "maxCalls": {
            "type": "integer",
            "minimum": 1
          },
          "maxTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1
          },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "description": "Enables the optional orchestration_run_plan tool (multi-task dependency waves with context-separated model judgment). Per-task grants and budgets are capped by the dispatch ceiling above.",
            "properties": {
              "maxTasks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "maxParallel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "verifierTier": {
                "type": "string",
                "enum": ["priority", "cheap", "standard", "strong"]
              }
            }
          }
        }
      },
      "ledger": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "description": "Enables the read-only orchestration_ledger_status tool over the coordinator's durable task ledger (absolute JSONL path).",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "observe": {
            "type": "boolean",
            "description": "Also record host subagent_spawned/subagent_ended hook events to <file>.observed.jsonl and report them in the status tool. Observation only."
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "orchestration_dispatch",
      "orchestration_run_plan",
      "orchestration_canary",
      "orchestration_ledger_status"
    ]
  },
  "toolMetadata": {
    "orchestration_dispatch": {
      "optional": true,
      "sideEffecting": true
    },
    "orchestration_run_plan": {
      "optional": true,
      "sideEffecting": true
    },
    "orchestration_canary": {
      "optional": true,
      "sideEffecting": false
    },
    "orchestration_ledger_status": {
      "optional": true,
      "sideEffecting": false
    }
  }
}
