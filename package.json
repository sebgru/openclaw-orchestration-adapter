{
  "name": "openclaw-orchestration-adapter",
  "version": "1.6.0",
  "description": "Least-privilege orchestration for OpenClaw agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebgru/openclaw-orchestration-adapter.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "skills",
    "openclaw.plugin.json",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 90 --statements 90 --functions 90 --branches 90 node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node --check src/index.js && node --check src/plan.js && node --check src/gates.js && node --check src/contracts.js && node --check src/dispatch.js && node --check src/model-routing.js && node --check src/memory-receipt.js && node --check src/worker-brief.js && node --check src/handoff.js && node --check src/handoff-store.js && node --check src/tool-guard.js && node --check src/worker-runtime.js && node --check src/plugin.js"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "reporter": [
      "text",
      "text-summary",
      "lcov"
    ],
    "reports-dir": "coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "c8": "^10.1.3",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.0"
  }
}
